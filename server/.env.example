# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/vortex

# Authentication Secrets (generate secure random strings in production)
JWT_SECRET=vortex_super_secret_jwt_access_key_2026
JWT_REFRESH_SECRET=vortex_super_secret_jwt_refresh_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Test Keys (Test Mode Only)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Resend Email Configuration (https://resend.com)
RESEND_API_KEY=re_YourResendApiKeyHere
RESEND_FROM="Vortex <onboarding@resend.dev>"

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
